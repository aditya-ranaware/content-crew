# Copy this file to .env and fill it in.
GEMINI_API_KEY=your_gemini_key_here
# Models are tried in order. When one hits its limit or is busy, the next is used.
GEMINI_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
# Create one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=paste_a_long_random_text_here
# Optional:
# DATABASE_URL=sqlite:///./content_crew.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
